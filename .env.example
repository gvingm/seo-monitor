# ============================================================
# seo-monitor — required environment variables
# Copy to .env and fill in real values
# ============================================================

# --- Yandex ---
# OAuth token for Yandex Webmaster + Metrika APIs
# Get at: https://oauth.yandex.ru/ (app with scope webmaster:read, metrika:read)
YANDEX_OAUTH_TOKEN=

# OAuth token for Yandex Search API v2 (Cloud)
# Get at: https://console.cloud.yandex.ru/ → Search API → Service Account key
YANDEX_CLOUD_TOKEN=

# Folder ID в Yandex Cloud (для Search API v2)
YANDEX_FOLDER_ID=

# ID сайта в Яндекс.Вебмастере (числится в URL webmaster: https://webmaster.yandex.ru/sites/<SITE_ID>/)
YANDEX_HOST_ID=

# Регионы для сбора данных
# Вебмастер: Москва=1, СПб=10174
YANDEX_REGION_WEBMASTER_MOSCOW=1
YANDEX_REGION_WEBMASTER_SPB=10174
# Search API: Москва=213, СПб=2
YANDEX_REGION_SEARCH_MOSCOW=213
YANDEX_REGION_SEARCH_SPB=2

# --- Google ---
# Service account JSON (base64 encoded) для GSC API
# gsutil bucket cp <file>.json <bucket>/ → или просто путь в контейнере
GOOGLE_APPLICATION_CREDENTIALS=/app/creds/gsc.json
# Сайт в GSC (например https://didalsk.ru)
GSC_SITE_URL=https://didalsk.ru

# --- Database ---
# PostgreSQL (Docker internal)
DATABASE_URL=postgresql://seomonitor:ChangeMe123@db:5432/seomonitor

# --- App ---
# Секрет для Telegram-уведомлений
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Минимум 32 символа
APP_SECRET_KEY=$(python -c "import secrets; print(secrets.token_hex(32))")

# Часовой пояс
TZ=Europe/Moscow

# Логирование
LOG_LEVEL=INFO
